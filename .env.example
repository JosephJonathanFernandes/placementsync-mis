# PlacementSync environment configuration
# Copy this file to .env and fill in your values. Never commit .env.

# Application
APP_NAME=PlacementSync
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database (SQLite for MVP; PostgreSQL later)
DATABASE_URL=sqlite:///./placement_sync.db

# Excel placement register
EXCEL_FILE_PATH=./exports/placement_register.xlsx

# Academic year
ACADEMIC_YEAR=2024-25

# Gmail OAuth (Phase 2) - leave empty for MVP
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# Optional LLM extraction provider (not required)
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=

# Gmail OAuth (Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# Frontend URL for OAuth callback redirect (Phase 2)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/placement_sync.log
